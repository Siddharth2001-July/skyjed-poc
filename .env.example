# Nutrient licence keys (ask your Nutrient contact)

# Document Authoring: used in the browser AND on the server (import, clean publish,
# comment extraction). For the server part the key must include the
# "Node.js Server-Side Runtime" feature; without it the server falls back to
# evaluation mode (1 hour per server start, watermarked PDF exports).
DOCAUTH_LICENSE_KEY=
# Optional: only if you were given a separate key for the Node.js runtime.
DOCAUTH_NODE_LICENSE_KEY=

DOCUMENT_ENGINE_ACTIVATION_KEY=
WEB_SDK_LICENSE_KEY=

# Document Engine (docker compose maps it to port 5001)
DE_URL=http://localhost:5001
DE_API_TOKEN=skyjed-demo-api-token
